# Copy to .env (which is gitignored) and fill in. NEVER commit the real .env.
# Mullvad over OpenVPN only needs your account number (the 16-digit one from your account).

OPENVPN_USER=your-mullvad-account-number
OPENVPN_PASSWORD=m            # Mullvad ignores the password; any value works
VPN_COUNTRY=Canada           # exit location (e.g. Canada, Sweden, USA)
