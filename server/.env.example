# Copy to .env (which is gitignored) and fill in. NEVER commit the real .env.
# Get these from Mullvad: Account -> WireGuard configuration -> generate a key.
# The generated config shows a [Interface] PrivateKey and Address.

WIREGUARD_PRIVATE_KEY=your-mullvad-wireguard-private-key
WIREGUARD_ADDRESSES=10.x.x.x/32          # the Address line from the Mullvad config
VPN_COUNTRY=Canada                       # exit location (e.g. Canada, Sweden, USA)
