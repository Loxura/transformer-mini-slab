# Copy to .env (which is gitignored) and fill in. NEVER commit the real .env.
# Mullvad is WireGuard-only. Get BOTH values by DOWNLOADING the config file from
# https://mullvad.net/en/account/wireguard-config/  (open the .conf in a text editor).

WIREGUARD_PRIVATE_KEY=your-private-key            # [Interface] PrivateKey = ...
WIREGUARD_ADDRESSES=10.x.x.x/32                   # [Interface] Address = ...  (the IPv4 part)
VPN_COUNTRY=Canada                                # exit location (e.g. Canada, Sweden, USA)
