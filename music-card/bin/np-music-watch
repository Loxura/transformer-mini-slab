#!/usr/bin/env bash
# Show the colour-adaptive Now Playing card ONLY while the "2:Music" workspace is focused.
# Self-contained: drives our own eww-music daemon/overlay via sway events. Touches none of
# the Dash eww or the deck-swipe script — the only shared thing is the workspace name.
set -uo pipefail

EWW="$HOME/.local/bin/eww"
CFG="$HOME/.config/eww-music"
WS_MUSIC="2:Music"

# Resolve the Wayland display ourselves (so this works from a systemd user unit that
# didn't inherit the graphical session env).
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [ -z "${WAYLAND_DISPLAY:-}" ]; then
  for s in "$XDG_RUNTIME_DIR"/wayland-*; do
    [ -S "$s" ] && [ "${s##*.}" != "lock" ] && { WAYLAND_DISPLAY="${s##*/}"; break; }
  done
  export WAYLAND_DISPLAY
fi

open()  { "$EWW" -c "$CFG" open  music >/dev/null 2>&1 || true; }
close() { "$EWW" -c "$CFG" close music >/dev/null 2>&1 || true; }

focused_ws() {
  swaymsg -t get_workspaces 2>/dev/null | python3 -c \
    'import sys,json; print(next((w["name"] for w in json.load(sys.stdin) if w.get("focused")),""))' 2>/dev/null
}

# make sure the daemon is up, then sync to the current workspace
"$EWW" -c "$CFG" daemon >/dev/null 2>&1 || true
[ "$(focused_ws)" = "$WS_MUSIC" ] && open || close

# react to workspace focus changes
swaymsg -t subscribe -m '["workspace"]' 2>/dev/null | while read -r line; do
  name=$(printf '%s' "$line" | python3 -c \
    'import sys,json
try:
    e=json.load(sys.stdin); print((e.get("current") or {}).get("name",""))
except Exception:
    print("")' 2>/dev/null)
  [ -z "$name" ] && continue
  if [ "$name" = "$WS_MUSIC" ]; then open; else close; fi
done
