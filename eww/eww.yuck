;; transformer-mini-slab — Dash (dark, full-screen). Top bar + body.
;; Body: analog clock · calendar + upcoming events · markets ticker.

(defpoll date     :interval "300s"  `date +"%A, %d %B"`)
(defpoll weather  :interval "1800s" `curl -s 'wttr.in/Winnipeg?format=%C+%t' 2>/dev/null || wget -qO- 'wttr.in/Winnipeg?format=%C+%t' 2>/dev/null`)
(defpoll ssid     :interval "30s"   `iw dev wlp1s0 link 2>/dev/null | sed -n 's/.*SSID: //p'`)
(defpoll ipaddr   :interval "30s"   `ip -4 -o addr show wlp1s0 2>/dev/null | awk '{print $4}' | head -1`)
(defpoll clockimg :interval "20s"   `~/.local/bin/analog-clock`)
(defpoll events   :interval "600s"  `python3 ~/.local/bin/gcal-events.py 2>/dev/null`)
(deflisten ticker :initial "loading markets…" `~/.local/bin/stock-ticker`)

(defwidget topbar []
  (box :class "topbar" :orientation "h" :space-evenly false :valign "start"
    (label :class "tb-item tb-date" :text date)
    (box :hexpand true)
    (label :class "tb-item" :text {weather != "" ? weather : "—"})
    (label :class "tb-sep"  :text "•")
    (label :class "tb-item" :text {ssid != "" ? ssid : "WiFi"})
    (label :class "tb-ip"   :text ipaddr)))

(defwidget body []
  (box :class "body" :orientation "h" :space-evenly false :vexpand true
    ;; analog clock
    (box :class "card clock-card" :valign "center" :halign "center"
      (image :class "analog" :path clockimg :image-width 240 :image-height 240))
    ;; calendar + upcoming events
    (box :class "card cal-card" :orientation "v" :space-evenly false :hexpand true
      (calendar :class "cal")
      (label :class "events-h" :text "UPCOMING")
      (label :class "events" :text {events != "" ? events : "nothing scheduled"} :wrap true :xalign 0))
    ;; markets
    (box :class "card ticker-card" :orientation "v" :space-evenly false :valign "center" :halign "center"
      (label :class "ticker-h" :text "MARKETS")
      (label :class "ticker"   :text ticker))))

(defwindow dashboard
  :monitor 0
  :stacking "bg"
  :exclusive false
  :focusable false
  :geometry (geometry :width "100%" :height "100%" :anchor "center")
  (box :class "dash" :orientation "v" :space-evenly false
    (topbar)
    (body)))

;; ============================ Music card (ws2) ============================
(defpoll np_title  :interval "1s"  `mpc -f '%title%'  current 2>/dev/null`)
(defpoll np_artist :interval "1s"  `mpc -f '%artist%' current 2>/dev/null`)
(defpoll vol       :interval "2s"  `wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | awk '{print int($2*100)}'`)
(defpoll queue     :interval "2s"  `mpc -f '%position%. %artist% - %title%' playlist 2>/dev/null | head -25`)
(defpoll arrivals  :interval "60s" `~/.local/bin/new-arrivals 2>/dev/null`)

(defwidget musiccard-w []
  (box :class "card-root" :orientation "v" :space-evenly false :valign "center" :halign "center"
    (label :class "np-title"  :text {np_title  != "" ? np_title  : "—"} :limit-width 42)
    (label :class "np-artist" :text {np_artist != "" ? np_artist : ""}  :limit-width 42)
    (box :class "row" :orientation "h" :space-evenly true
      (button :class "btn"     :onclick "~/.local/bin/music-ctl prev"   "‹ prev")
      (button :class "btn big" :onclick "~/.local/bin/music-ctl toggle" "play / pause")
      (button :class "btn"     :onclick "~/.local/bin/music-ctl next"   "next ›"))
    (box :class "row" :orientation "h" :space-evenly true
      (button :class "btn"     :onclick "~/.local/bin/music-ctl shuffleartist" "shuffle artist")
      (button :class "btn"     :onclick "~/.local/bin/music-ctl shuffleall"    "shuffle all")
      (button :class "btn fav" :onclick "~/.local/bin/music-ctl favorite"      "+ favorite"))
    (box :class "row" :orientation "h" :space-evenly true
      (button :class "btn" :onclick "~/.local/bin/music-ctl voldown" "vol −")
      (label  :class "vol" :text "${vol}%")
      (button :class "btn" :onclick "~/.local/bin/music-ctl volup"   "vol +")
      (button :class "btn" :onclick "~/.local/bin/music-ctl mute"    "mute"))
    (label :class "sec" :text "NEW ARRIVALS")
    (box :class "arrivals" :orientation "v" :space-evenly false
      (for a in arrivals
        (button :class "album" :onclick "~/.local/bin/music-ctl playalbum '${a.path}'"
          (label :class "album-name" :text {a.name} :limit-width 48 :xalign 0))))
    (label :class "sec" :text "QUEUE")
    (scroll :class "queue" :vscroll true
      (label :text {queue != "" ? queue : "queue empty"} :xalign 0))))

(defwindow musiccard
  :monitor 0
  :stacking "bg"
  :exclusive false
  :focusable false
  :geometry (geometry :width "100%" :height "100%" :anchor "center")
  (musiccard-w))
