### transformer-mini-slab — sway "swipe deck"
### Modes = workspaces: 1 Dash · 2 Now Playing · 3 Video
### Hardware: output DSI-1 (portrait panel), touch ELAN22A6

set $mod Mod4

### DISPLAY — rotate the portrait panel to landscape ###########################
# transform 90; if the image is upside-down, change 90 -> 270 and reload.
output DSI-1 transform 90
output "*" bg #F4F1EA solid_color

### INPUT — map touch + stylus onto the (rotated) output ######################
input "1267:8870:ELAN22A6:00_04F3:22A6" map_to_output DSI-1
input "1267:8870:ELAN22A6:00_04F3:22A6_Stylus" map_to_output DSI-1

### E-INK BASELINE — flat, calm, fast ########################################
default_border none
default_floating_border none
gaps inner 0
gaps outer 0
font pango:JetBrains Mono 11

### WORKSPACES = modes #######################################################
set $ws1 "1:Dash"
set $ws2 "2:Music"
set $ws3 "3:Video"

### AUTOSTART — one eww "deck" surface; its content follows the focused workspace ####
# exec waybar   # hidden — the eww Dash top bar replaces it
exec /home/minideck/.local/bin/deck-launch  # single full-screen eww window (Dash + Music card)
exec /home/minideck/.local/bin/audio-route-fix  # re-route audio to the speaker after boot (WirePlumber UCM quirk)
assign [app_id="mpv"] $ws3        # Video: mpv lands here on demand
workspace $ws1

### TOUCH SWIPE between modes (lisgd) ########################################
# 1-finger swipe L/R -> prev/next workspace.
# -o is an orientation STEP (0..3), not degrees: lisgd reads the raw panel (portrait),
# bypassing sway's transform, so a landscape swipe is rotated back with -o 1 (=90deg).
# Use -o 3 if you switch the output to transform 270, or if swipes go the wrong way.
# -t = min swipe distance px, -r = angle leniency deg (max 45), -m = max swipe time ms.
exec lisgd -d /dev/input/event0 -o 1 -t 120 -r 40 -m 800 -g "1,LR,*,*,*,/home/minideck/.local/bin/deck-swipe prev" -g "1,RL,*,*,*,/home/minideck/.local/bin/deck-swipe next"

### KEYBOARD (when the keyboard's attached) ##################################
bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+Return exec foot
bindsym $mod+d exec fuzzel
bindsym $mod+Shift+q kill
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit sway?' -B 'Yes' 'swaymsg exit'

# volume / brightness / media
bindsym XF86AudioRaiseVolume exec pamixer -i 5
bindsym XF86AudioLowerVolume exec pamixer -d 5
bindsym XF86AudioMute        exec pamixer -t
bindsym XF86MonBrightnessUp   exec brightnessctl set +10%
bindsym XF86MonBrightnessDown exec brightnessctl set 10%-
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous

include /etc/sway/config.d/*
