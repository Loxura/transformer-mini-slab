# Copy to .env (which is gitignored) and fill in. NEVER commit the real .env.
#
# Generate the two secrets:
#   SECRET_KEY:        head -c50 /dev/urandom | base64
#   POSTGRES_PASSWORD: head -c24 /dev/urandom | base64

# --- Django ---
SECRET_KEY=replace-me-with-a-50+-char-random-string
TZ=America/Winnipeg
DEBUG=0
# LAN-only direct access: * is the path of least resistance. No reverse proxy in front,
# so CSRF_TRUSTED_ORIGINS is NOT needed (only matters behind a proxy/hostname).
ALLOWED_HOSTS=*

# --- Database (bundled postgres:16-alpine; host = the compose service name) ---
DB_ENGINE=django.db.backends.postgresql
POSTGRES_HOST=db_recipes
POSTGRES_PORT=5432
POSTGRES_USER=djangouser
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=djangodb

# nginx (bundled) serves media, not gunicorn.
GUNICORN_MEDIA=0

# After first boot: register the first account in the browser -> it becomes superuser ->
# create a Space -> then set ENABLE_SIGNUP=0 and `docker compose up -d` to lock signup.
ENABLE_SIGNUP=1
